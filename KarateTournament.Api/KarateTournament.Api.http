@KarateTournament.Api_HostAddress = https://localhost:7086

GET {{KarateTournament.Api_HostAddress}}/api/categories
Accept: application/json

###

# Укажите существующий ID категории (он также возвращается в заголовке Location после POST).
GET {{KarateTournament.Api_HostAddress}}/api/categories/1
Accept: application/json

###

GET {{KarateTournament.Api_HostAddress}}/api/tournament
Accept: application/json

###

POST {{KarateTournament.Api_HostAddress}}/api/participants
Content-Type: application/json

{
  "firstName": "Иван",
  "lastName": "Смирнов",
  "age": 12,
  "club": "Клуб карате",
  "belt": 8,
  "sex": 1,
  "categoryTypes": [0, 1]
}

###

# Укажите ID, возвращённый в заголовке Location после POST.
GET {{KarateTournament.Api_HostAddress}}/api/participants/1
Accept: application/json

###

# Укажите в participantIds ID созданных спортсменов или оставьте пустой массив [].
POST {{KarateTournament.Api_HostAddress}}/api/categories
Content-Type: application/json

{
  "name": "Ката 10–12 лет",
  "minAge": 10,
  "maxAge": 12,
  "sex": 3,
  "categoryType": 0,
  "allowedBelts": [8, 7],
  "participantIds": [1]
}

###
