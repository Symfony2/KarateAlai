<Window x:Class="KarateTournamentApp.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:KarateTournamentApp"
xmlns:converters="clr-namespace:KarateTournamentApp.Converters"
xmlns:shared="clr-namespace:KarateClassLibrary;assembly=KarateClassLibrary"
xmlns:system="clr-namespace:System;assembly=System.Runtime"
mc:Ignorable="d"
Title="Менеджер турнира по каратэ Алай" Height="917" Width="1524" Background="#F0F0F0" WindowState="Maximized">

    <Window.Resources>
        <ObjectDataProvider x:Key="BeltsEnum" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="shared:Belts"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="SexEnum" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="shared:Sex"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ExpanderIconConverter x:Key="ExpanderIconConverter"/>
        <converters:EnumToRussianTextConverter x:Key="EnumToRussianTextConverter"/>

        <Style x:Key="DisciplineTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#40536A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#E9EEF4" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#245B8F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SexFilterButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#4B5C70"/>
            <Setter Property="Background" Value="#EEF2F6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="FilterBorder" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FilterBorder" Property="Background" Value="#DDF1E5"/>
                                <Setter Property="Foreground" Value="#187044"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190*"/>
            <ColumnDefinition Width="191*"/>
        </Grid.ColumnDefinitions>
        <ToggleButton x:Name="MenuToggle"
                      Width="40" 
                      Height="60"
                      HorizontalAlignment="Left" 
                      VerticalAlignment="Top"
                      Margin="5,5,0,0"
                      Background="#2C3E50"
                      Foreground="White"
                      BorderThickness="0"
                      Cursor="Hand"
                      Panel.ZIndex="1000">
            <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="5"
                                        Padding="8">
                                    <TextBlock Text="☰" 
                                               FontSize="24" 
                                               FontWeight="Bold"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#34495E"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="#1ABC9C"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ToggleButton.Style>
        </ToggleButton>

        <!-- Left side menu  -->
        <Border x:Name="SideMenu"
                Width="200"
                HorizontalAlignment="Left"
                Background="#2C3E50"
                BorderThickness="0,0,2,0"
                BorderBrush="#1ABC9C"
                Panel.ZIndex="999"
                Visibility="{Binding IsChecked, ElementName=MenuToggle, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel Margin="0,70,0,0">
                <!-- Import -->
                <Button Command="{Binding ImportCommand}"
                        Background="#27AE60"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="15,12"
                        Margin="10,5"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Импорт" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#229954"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Export -->
                <Button Command="{Binding ExportCommand}"
                        Background="#E67E22"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="15,12"
                        Margin="10,5"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📤" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Экспорт" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#CA6F1E"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Separator -->
                <Separator Margin="10,10" Background="#34495E"/>

                <!-- Import Excel -->
                <Button Command="{Binding ImportExcelCommand}"
                        Background="#2ECC71"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="15,12"
                        Margin="10,5"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Импорт из Excel" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#27AE60"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Create Excel Template -->
                <Button Command="{Binding CreateExcelTemplateCommand}"
                        Background="#1ABC9C"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="15,12"
                        Margin="10,5"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📑" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Шаблон Excel" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#17A689"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main part -->
        <Grid Margin="20,20,20,20" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Loading Overlay -->
            <Border Grid.ColumnSpan="2"
                    Background="#80000000"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    Panel.ZIndex="9999">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="200"
                                 Height="20"
                                 Margin="0,0,0,20"/>
                    <TextBlock Text="Загрузка..."
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" BorderBrush="#E3E8EF" BorderThickness="1" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Регистрация спортсмена" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#333"/>

                        <Border Background="#EEF5FF" BorderBrush="#D7E6FA" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                            <TextBlock Text="Группировка по возрасту, весу и поясу настраивается в панели «Правила категорий» справа." Foreground="#36506F" TextWrapping="Wrap" FontSize="12"/>
                        </Border>

                        <TextBlock Text="Имя:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Фамилия:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Возраст:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" Padding="7"/>

                        <TextBlock Text="Вес, кг (для кумитэ):" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding WeightKgText, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" Padding="7" ToolTip="Можно указать дробный вес, например 52,5. Поле необязательное."/>

                        <TextBlock Text="Страна (необязательно):" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding CountryOptions}" Text="{Binding SelectedCountry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" Padding="5" IsEditable="True" IsTextSearchEnabled="True"/>

                        <TextBlock Text="Пол (обязательно):" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource SexEnum}}"
                                  SelectedItem="{Binding SelectedSex}" Margin="0,5,0,15" Padding="5">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToRussianTextConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Пояс:" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource BeltsEnum}}"
                                  SelectedItem="{Binding SelectedBelt}" Margin="0,5,0,15" Padding="5">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToRussianTextConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Дисциплины (минимум одна):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding CategorySelections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}" 
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                          Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Клуб (необязательно):" Margin="0,15,0,5" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Club}" Margin="0,0,0,20" Padding="5"/>

                        <Button Content="ДОБАВИТЬ СПОРТСМЕНА" 
                            Command="{Binding AddParticipantCommand}" 
                            Height="40" Background="#27AE60" Foreground="White" FontWeight="Bold" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="20,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Дисциплины и категории" FontSize="21" FontWeight="Bold" Margin="2,0,0,10" Foreground="#1C2B3A"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TabControl Grid.Column="0"
                                SelectedIndex="{Binding SelectedDisciplineIndex, Mode=TwoWay}"
                                ItemContainerStyle="{StaticResource DisciplineTabItemStyle}"
                                Background="Transparent" BorderThickness="0" Height="38">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <Border Background="Transparent">
                                    <TabPanel IsItemsHost="True" Background="Transparent"/>
                                </Border>
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabItem Header="Кумитэ"/>
                        <TabItem Header="Ката"/>
                        <TabItem Header="Кихон"/>
                        <TabItem Header="Другие дисциплины"/>
                    </TabControl>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <RadioButton GroupName="SexFilter" Style="{StaticResource SexFilterButtonStyle}" Content="Все" IsChecked="{Binding IsAllSexesFilter, Mode=TwoWay}"/>
                        <RadioButton GroupName="SexFilter" Style="{StaticResource SexFilterButtonStyle}" Content="Мужской" IsChecked="{Binding IsMaleFilter, Mode=TwoWay}"/>
                        <RadioButton GroupName="SexFilter" Style="{StaticResource SexFilterButtonStyle}" Content="Женский" IsChecked="{Binding IsFemaleFilter, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="ПРАВИЛА КАТЕГОРИЙ" FontSize="12" FontWeight="Bold" Foreground="#60758D" Margin="0,0,0,7"/>
                            <CheckBox Content="Разделять по возрасту" IsChecked="{Binding DivideByAge, Mode=TwoWay}" Margin="0,3" FontWeight="SemiBold"/>
                            <CheckBox Content="Разделять по весу (только кумитэ)" IsChecked="{Binding DivideByWeight, Mode=TwoWay}" Margin="0,3" FontWeight="SemiBold"/>
                            <CheckBox Content="Разделять по поясам" IsChecked="{Binding DivideByBelt, Mode=TwoWay}" Margin="0,3" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Возрастные диапазоны" FontWeight="SemiBold" Foreground="#34465F" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding AgeRangesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="55" MaxHeight="70" Padding="7" FontSize="12" ToolTip="Пример: до 5; 6-8; 9-10; 11-13; 14-15; 16; 17; 18; 19+"/>
                            <TextBlock Text="Формат: до 5; 6-8; 9-10; 19+" Foreground="#8795A5" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Весовые диапазоны, кг" FontWeight="SemiBold" Foreground="#34465F" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding WeightRangesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="55" MaxHeight="70" Padding="7" FontSize="12" ToolTip="Пример: до 25; 25-30; 31-35; 36-40; 81+"/>
                            <TextBlock Text="Дробный вес округляется вверх до целого кг" Foreground="#8795A5" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="150">
                            <Button Content="Применить правила" Command="{Binding ApplyGroupingRulesCommand}" Background="#1769AA" Foreground="White" FontWeight="Bold" Padding="14,10" BorderThickness="0" Cursor="Hand"/>
                            <TextBlock Text="{Binding GroupingSummary}" TextWrapping="Wrap" Foreground="#60758D" FontSize="10" Margin="0,7,0,0" MaxWidth="190"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#EAF3FC" BorderBrush="#C9DDF1" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,0,0,9"
                            Visibility="{Binding HasMultipleCategoriesSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Снять выделение" Command="{Binding ClearCategorySelectionCommand}"
                                        Background="Transparent" Foreground="#52677D" BorderThickness="0"
                                        Padding="10,7" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button Content="{Binding MergeSelectedButtonText}" Command="{Binding MergeSelectedCategoriesCommand}"
                                        Background="#1769AA" Foreground="White" FontWeight="Bold"
                                        Padding="16,8" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="Выбрано несколько категорий" Foreground="#234B73" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="Спортсмены объединятся в одну категорию. Выбирайте категории одной дисциплины."
                                           Foreground="#60758D" FontSize="10" Margin="0,2,10,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding VisibleCategories}" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" 
                                    CornerRadius="5" Margin="0,0,0,10" Padding="0"
                                    x:Name="CategoryBorder">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Переименовать категорию" Command="{Binding RenameCommand}"/>
                                            <MenuItem Header="Просмотреть турнирную сетку" Command="{Binding ViewBracketCommand}"/>
                                            <MenuItem Header="Открыть результаты" Command="{Binding ViewResultsCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Удалить категорию" Command="{Binding DeleteCommand}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <!-- Compact category header: title and metadata on the left, actions in two tidy rows. -->
                                        <Grid Background="#F4F7FA" Margin="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="280"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelectedForMerge, Mode=TwoWay}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Margin="8,0,4,0"
                                                      ToolTip="Выбрать категорию для объединения"/>

                                            <ToggleButton Grid.Column="1"
                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                          Width="28" Height="30" Margin="4"
                                                          Background="White" BorderBrush="#DCE4ED" BorderThickness="1"
                                                          Cursor="Hand">
                                                <TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                                                           Foreground="#50647A"
                                                           Text="{Binding IsExpanded, Converter={StaticResource ExpanderIconConverter}}"/>
                                            </ToggleButton>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,8,8,8">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" FontSize="15" Foreground="#1D2C3D" TextTrimming="CharacterEllipsis"/>
                                                <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center">
                                                    <Border Background="#E5F1FC" CornerRadius="4" Padding="7,3" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding CategoryTypeDisplay, Mode=OneWay}" Foreground="#23669B" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border Background="#EEF1F5" CornerRadius="4" Padding="7,3" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding SexDisplay, Mode=OneWay}" Foreground="#536477" FontSize="11"/>
                                                    </Border>
                                                    <Border Background="#E8F5EC" CornerRadius="4" Padding="7,3" Margin="0,0,6,4">
                                                        <TextBlock Foreground="#287447" FontSize="11" FontWeight="SemiBold">
                                                            <Run Text="{Binding ParticipantCount, Mode=OneWay}"/>
                                                            <Run Text=" "/>
                                                            <Run Text="{Binding ParticipantCountLabel, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Background="#FFF0D6" BorderBrush="#F1D39C" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,6,4"
                                                            Visibility="{Binding HasSingleParticipant, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="Нет соперника" Foreground="#8B5B16" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding KumiteWinnerDisplay, Mode=OneWay}" Margin="0,2,0,0" Foreground="#B23A48" FontWeight="Bold"
                                                           Visibility="{Binding HasKumiteWinner, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,5,7,5">
                                                <Button Command="{Binding InitializeBracketCommand}" Content="Жеребьёвка" Width="96" Height="36" Margin="2" Background="#D99521" Foreground="White" BorderThickness="0" FontSize="10" FontWeight="Bold"
                                                        Visibility="{Binding IsKumite, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="Случайно распределить участников по сетке"/>
                                                <Button Command="{Binding ViewBracketCommand}" Content="Сетка" Width="72" Height="36" Margin="2" Background="#1769AA" Foreground="White" BorderThickness="0" FontSize="10" FontWeight="Bold"
                                                        Visibility="{Binding IsKumite, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="Просмотреть турнирную сетку и сохранить протокол в PDF"/>
                                                <Button Command="{Binding StartCompetitionCommand}" Content="Старт" Width="68" Height="36" Margin="2" Background="#7955A5" Foreground="White" BorderThickness="0" FontSize="10" FontWeight="Bold"
                                                        ToolTip="Открыть табло и панель судьи"/>
                                            </StackPanel>
                                        </Grid>



                                        <!-- Participant list (after expanding) -->
                                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="0,1,0,0">
                                            <ItemsControl ItemsSource="{Binding Category.Participants}" 
                                                      Margin="10,10,10,5">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="White" Padding="12,8" Margin="0,0,0,5" 
                                                            BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="13"/>
                                                                    <TextBlock Text="{Binding Country}" Foreground="#8795A5" FontSize="10" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="3" 
                                                                    Padding="8,3" Margin="10,0,5,0">
                                                                    <TextBlock Text="{Binding Age}" Foreground="#27AE60" 
                                                                           FontWeight="SemiBold" FontSize="12"/>
                                                                </Border>
                                                                <Border Grid.Column="2" Background="#FFF3E0" CornerRadius="3" 
                                                                    Padding="8,3" Margin="5,0">
                                                                    <TextBlock Text="{Binding Belt, Converter={StaticResource EnumToRussianTextConverter}}" Foreground="#F57C00" 
                                                                           FontWeight="SemiBold" FontSize="12"/>
                                                                </Border>
                                                                <Border Grid.Column="3" Background="#F0EAFE" CornerRadius="3" Padding="7,3" Margin="5,0"
                                                                        Visibility="{Binding HasWeight, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding WeightKg, StringFormat={}{0:0.##} кг}" Foreground="#6746A5" FontWeight="SemiBold" FontSize="11"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="4" Text="{Binding Club}" Margin="10,0,10,0"
                                                                       Foreground="#8795A5" FontStyle="Italic" VerticalAlignment="Center"/>

                                                                <!-- Remove participant button -->
                                                                <Button Grid.Column="5"
                                                                        Command="{Binding DataContext.RemoveParticipantCommand, ElementName=CategoryBorder}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="✕"
                                                                        Background="#E74C3C"
                                                                        Foreground="White"
                                                                        FontWeight="Bold"
                                                                        Width="25"
                                                                        Height="25"
                                                                        Padding="0"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        ToolTip="Удалить спортсмена из категории">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}"
                                                                                                CornerRadius="3"
                                                                                                Padding="{TemplateBinding Padding}">
                                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#C0392B"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                                <ItemsControl.Template>
                                                    <ControlTemplate>
                                                        <ScrollViewer VerticalScrollBarVisibility="Disabled" 
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                            <ItemsPresenter/>
                                                        </ScrollViewer>
</ControlTemplate>
                                                </ItemsControl.Template>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="1"
                            Visibility="{Binding IsCategoryListEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False" Margin="20">
                    <TextBlock Text="Здесь пока нет категорий"
                               FontSize="19" FontWeight="SemiBold" Foreground="#60758D"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Добавьте спортсменов или выберите другую дисциплину / пол."
                               FontSize="12" Foreground="#8795A5" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,7,0,0" MaxWidth="330"/>
                </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
