<UserControl x:Class="KarateTournamentApp.Views.ScoreboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:KarateTournamentApp.Views"
             xmlns:converters="clr-namespace:KarateTournamentApp.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600"
             Background="#0B1220">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.5*"/>
            <ColumnDefinition Width="1.05*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="3.1*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- Public tournament bracket on the secondary monitor. -->
        <local:BracketView Grid.Row="0" Margin="0,0,0,12"/>

        <!-- Current bout scoreboard. -->
        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- AKA / red corner. -->
            <Border Grid.Column="0"
                    Background="#A92F3B"
                    BorderBrush="#D94A55"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="АКА · КРАСНЫЙ УГОЛ"
                               Foreground="#FFE7E9"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AkaName}"
                                   Foreground="White"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxHeight="78"/>
                        <TextBlock Text="{Binding AkaScore}"
                                   Foreground="White"
                                   FontSize="72"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsShobuSanbon, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#82232D" CornerRadius="6" Padding="10,5" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Атэнай: " Foreground="#FFE4A3" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AkaAtenai}" Foreground="#FFE4A3" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#82232D" CornerRadius="6" Padding="10,5" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Чукоку: " Foreground="#FFE4A3" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AkaChukoku}" Foreground="#FFE4A3" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#641B24" CornerRadius="6" Padding="10,5" Margin="4,0"
                                Visibility="{Binding AkaHansoku, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="ХАНСОКУ" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Timer in the center. -->
            <Border Grid.Column="1"
                    Background="#1B2A3D"
                    BorderBrush="#344B67"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,12"
                    Margin="12,0"
                    MinWidth="150"
                    Visibility="{Binding IsShobuSanbon, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ВРЕМЯ"
                               Foreground="#91A4BD"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TimeDisplay}"
                               Foreground="#F5C451"
                               FontSize="42"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="ТЕКУЩИЙ ПОЕДИНОК"
                               Foreground="#91A4BD"
                               FontSize="9"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- SHIRO / white corner. -->
            <Border Grid.Column="2"
                    Background="#EDF2F7"
                    BorderBrush="#C9D3DF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="СИРО · БЕЛЫЙ УГОЛ"
                               Foreground="#40516A"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ShiroName}"
                                   Foreground="#172337"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxHeight="78"/>
                        <TextBlock Text="{Binding ShiroScore}"
                                   Foreground="#172337"
                                   FontSize="72"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsShobuSanbon, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#DCE4ED" CornerRadius="6" Padding="10,5" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Атэнай: " Foreground="#34465F" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ShiroAtenai}" Foreground="#34465F" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#DCE4ED" CornerRadius="6" Padding="10,5" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Чукоку: " Foreground="#34465F" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ShiroChukoku}" Foreground="#34465F" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F7DDE0" CornerRadius="6" Padding="10,5" Margin="4,0"
                                Visibility="{Binding ShiroHansoku, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="ХАНСОКУ" Foreground="#9E2733" FontSize="13" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Grid>

        <!-- Compact podium on the right; the tournament bracket and the main scoreboard stay unchanged. -->
        <Border Grid.Column="1"
                Background="#121E30"
                BorderBrush="#26364D"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12"
                Margin="12,0,0,0">
            <StackPanel>
                <TextBlock Text="ПЬЕДЕСТАЛ"
                           Foreground="#F4F7FB"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="ИТОГИ КАТЕГОРИИ"
                           Foreground="#91A4BD"
                           FontSize="9"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,3,0,16"/>

                <Grid Height="280" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 2nd place -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="86"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" Margin="2,0,2,7">
                            <TextBlock Text="{Binding SecondPlaceName}" Foreground="#E7EDF5" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="42"/>
                            <TextBlock Text="{Binding SecondPlaceCountry}" Foreground="#91A4BD" FontSize="9" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Row="1" Height="112" VerticalAlignment="Bottom" Background="#8794A7" CornerRadius="7,7,2,2" Padding="4">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="2" Foreground="#172337" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="СЕРЕБРО" Foreground="#172337" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 1st place -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="86"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" Margin="2,0,2,7">
                            <TextBlock Text="{Binding FirstPlaceName}" Foreground="#FFF0BF" FontSize="11" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="42"/>
                            <TextBlock Text="{Binding FirstPlaceCountry}" Foreground="#CBB77B" FontSize="9" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Row="1" Height="160" VerticalAlignment="Bottom" Background="#D7A83E" CornerRadius="7,7,2,2" Padding="4">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="1" Foreground="#392B0D" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="ЗОЛОТО" Foreground="#392B0D" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 3rd place -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="86"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" Margin="2,0,2,7">
                            <TextBlock Text="{Binding ThirdPlaceName}" Foreground="#E9C6A8" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="42"/>
                            <TextBlock Text="{Binding ThirdPlaceCountry}" Foreground="#B89476" FontSize="9" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Row="1" Height="82" VerticalAlignment="Bottom" Background="#A86F4E" CornerRadius="7,7,2,2" Padding="4">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="3" Foreground="#2E1A10" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="БРОНЗА" Foreground="#2E1A10" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Border Background="#1B2A3D" CornerRadius="8" Padding="9" Margin="0,14,0,0">
                    <TextBlock Text="Места обновляются автоматически после завершения финала и боя за бронзу."
                               Foreground="#91A4BD" FontSize="10" TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
