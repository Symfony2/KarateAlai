<UserControl x:Class="KarateTournamentApp.Views.BracketPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KarateTournamentApp.Views"
             Background="#EDF2F7"
             Unloaded="BracketPreviewView_OnUnloaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172B45" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ПРОСМОТР ТУРНИРНОЙ СЕТКИ"
                               Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CategoryName}" Foreground="#D7E3F1" FontSize="14" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding TournamentState}" Foreground="#9FB4CC" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="ПЕЧАТЬ / PDF"
                        Click="ExportPdfOrPrint_Click"
                        Background="#D6A43A" Foreground="#172337"
                        FontWeight="Bold" FontSize="12"
                        Padding="18,11" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center"
                        ToolTip="В окне печати выберите Microsoft Print to PDF, чтобы сохранить протокол в PDF"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#121E30" CornerRadius="12" Padding="8" Margin="0,0,12,0">
                <local:BracketView DataContext="{Binding Scoreboard}"/>
            </Border>

            <Border Grid.Column="1" Background="#17263B" BorderBrush="#2B3D56" BorderThickness="1" CornerRadius="12" Padding="14">
                <StackPanel>
                    <TextBlock Text="ПЬЕДЕСТАЛ" Foreground="#F4F7FB" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CategoryName}" Foreground="#91A4BD" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,14"/>

                    <Border Background="#D7A83E" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="1 МЕСТО · ЗОЛОТО" Foreground="#3B2A08" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding FirstPlaceName}" Foreground="#241A07" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding FirstPlaceCountry}" Foreground="#5B4518" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#AAB6C5" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="2 МЕСТО · СЕРЕБРО" Foreground="#243247" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SecondPlaceName}" Foreground="#172337" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SecondPlaceCountry}" Foreground="#40516A" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#B9784C" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="3 МЕСТО · БРОНЗА" Foreground="#321B0D" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ThirdPlaceName}" Foreground="#2A170D" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding ThirdPlaceCountry}" Foreground="#4B2C1B" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#223650" CornerRadius="7" Padding="10" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="УЧАСТНИКИ" Foreground="#91A4BD" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ParticipantCount}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SexName}" Foreground="#B8C7D9" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Результаты пьедестала обновляются по мере завершения поединков."
                               Foreground="#91A4BD" FontSize="10" TextWrapping="Wrap" Margin="2,12,2,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
